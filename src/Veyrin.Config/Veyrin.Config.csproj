<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	
	    <!-- 套件定位 -->
    <AssemblyName>Veyrin.Config</AssemblyName>
    <RootNamespace>Veyrin.Config</RootNamespace>
	    <!-- NuGet 發佈資訊（可依需要調整） -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>Veyrin</Authors>
    <Company>Veyrin</Company>
    <Description>Veyrin configuration abstraction and loading library</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Abstractions\IAppEnvironment.cs" />
  </ItemGroup>

  <ItemGroup>
	    <!-- Core Configuration Abstractions -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />

    <!-- Strong typed binding -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />

    <!-- File providers -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Xml" Version="8.0.0" />

    <!-- Reload token -->
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veyrin.Core\Veyrin.Core.csproj" />
  </ItemGroup>

</Project>
